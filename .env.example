# Server-only secrets. Never commit real values.
# Supabase Auth
SUPABASE_URL=https://[PROJECT-REF].supabase.co
SUPABASE_ANON_KEY=replace-with-supabase-anon-key
# Used only by the synchronous server-side JWT authorization helper when the project uses HS256 JWTs.
SUPABASE_JWT_SECRET=replace-with-supabase-jwt-secret
# Supabase PostgreSQL connection string.
DATABASE_URL=postgresql://postgres.[PROJECT-REF]:[PASSWORD]@[POOLER-HOST]:5432/postgres

# Legacy ADMIN_PASSWORD is no longer used for authentication after Phase 7.4.
# ADMIN_PASSWORD=deprecated

# Optional public configuration
VITE_MODEL_URL=https://example.com/site-map.glb
EV_CHARGER_COUNT=2
